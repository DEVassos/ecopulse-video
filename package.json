{
  "name": "video ecopulse",
  "version": "1.0.0",
  "description": "Vídeo de apresentação do EcoPulse (GreenOps SaaS) para o estande",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/fonts": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "@remotion/zod-types": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.545",
    "@remotion/tailwind-v4": "4.0.545",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "scan": "node scripts/scan-assets.mjs",
    "predev": "npm run scan",
    "dev": "remotion studio",
    "studio:start": "node scripts/studio.mjs start",
    "studio:stop": "node scripts/studio.mjs stop",
    "studio:status": "node scripts/studio.mjs status",
    "prebuild": "npm run scan",
    "build": "remotion bundle",
    "render": "remotion render EcoPulseMain out/ecopulse-main.mp4 --props='{\"showPlaceholders\":false}'",
    "render:short": "remotion render EcoPulseShort out/ecopulse-short.mp4 --props='{\"showPlaceholders\":false}'",
    "still": "remotion still EcoPulseMain",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "normalize-videos": "node scripts/normalize-videos.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
